{
  "extends": "./tsconfig.json", // Extends your base tsconfig
  "compilerOptions": {
    "jsx": "react-jsx", // Use React JSX transform
    "module": "ESNext", // Ensure module is set to ESNext for ESM support
    "target": "ESNext", // Set the target for ESNext for modern JS features
    "esModuleInterop": true, // Allows interop between ESModules and CommonJS
    "allowSyntheticDefaultImports": true, // Allows default imports from modules with no default export
    "moduleResolution": "node", // Resolves modules in a Node.js style
    "isolatedModules": true // Needed for compatibility with 'ts-jest'
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
  ],
  "exclude": [
    "node_modules"
  ]
}
